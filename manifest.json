{
  "manifest_version": 3,
  "name": "多意 MulTranslate",
  "version": "1.1.0",
  "description": "网页自动注入目标语言对照：正文上下分块、导航单行对照、表单控件翻译。支持 English/中文/韩语/日语/西班牙语/法语互译。",
  "permissions": ["storage"],
  "host_permissions": [
    "<all_urls>",
    "https://edge.microsoft.com/*",
    "https://api.cognitive.microsofttranslator.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/page-detect.js",
        "lib/toolbar.js",
        "lib/collect.js",
        "lib/apply.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "多意",
    "default_popup": "popup.html"
  }
}
